      "title": "Độ Trễ Phản Hồi Trung Bình (Latency Seconds)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(http_request_duration_seconds_sum[1m]) / rate(http_request_duration_seconds_count[1m])",
          "legendFormat": "{{job}} - {{handler}}",
          "refId": "A"
        }
      ]
