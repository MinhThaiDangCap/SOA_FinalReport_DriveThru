      "title": "Lưu Lượng HTTP Requests Theo Service (Requests/sec)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (job, handler) (rate(http_requests_total[1m]))",
          "legendFormat": "{{job}} - {{handler}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
