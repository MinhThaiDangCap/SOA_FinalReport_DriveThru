      "type": "bargauge",
      "targets": [
        {
          "expr": "sum by (role, status) (auth_logins_total)",
          "legendFormat": "{{role}} ({{status}})",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
