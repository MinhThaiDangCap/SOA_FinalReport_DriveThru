# Cách dùng: sao chép file này thành .env rồi điền giá trị của bạn.
#   Windows PowerShell:  Copy-Item .env.example .env
# KHÔNG commit file .env (đã nằm trong .gitignore).

# ===== PostgreSQL =====
# Mặc định cổng 5432. Nếu cổng bị chiếm thì chạy container ở cổng khác và đổi số này.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ===== Tên database của từng service =====
AUTH_DB=auth_db
MENU_DB=menu_db
ORDER_DB=order_db
PAYMENT_DB=payment_db
FEEDBACK_DB=feedback_db

# ===== JWT (auth-service phát, các service khác kiểm tra) =====
# Cả nhóm phải dùng CÙNG giá trị. Trưởng nhóm gửi giá trị thật qua tin nhắn riêng.
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ===== Gọi nội bộ giữa các service =====
# Cả nhóm phải dùng CÙNG INTERNAL_KEY.
# Địa chỉ dưới đây dùng khi chạy local. Khi chạy bằng Docker Compose,
# từng container sẽ được ghi đè thành http://<tên-service>:8000.
INTERNAL_KEY=change_me_internal_key
AUTH_SERVICE_URL=http://127.0.0.1:8001
MENU_SERVICE_URL=http://127.0.0.1:8002
ORDER_SERVICE_URL=http://127.0.0.1:8003
PAYMENT_SERVICE_URL=http://127.0.0.1:8004

# ===== Chế độ giả lập khi dev (mặc định tắt) =====
# order-service: true = dùng món giả khi menu-service chưa chạy
MENU_MOCK=false
# payment-service: true = thanh toán giả, không gọi VNPay thật
PAYMENT_MOCK_MODE=false
# payment-service: true = trang return cũng xử lý kết quả
# (chỉ dùng khi VNPay chưa gọi được IPN vào máy local)
VNP_PROCESS_ON_RETURN=false
PUBLIC_BASE_URL=http://127.0.0.1:8004

# ===== VNPay Sandbox (nhận qua email khi đăng ký sandbox, KHÔNG commit giá trị thật) =====
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Địa chỉ trang kết quả của web. Khi demo thật thì dùng link ngrok
VNP_RETURN_URL=http://localhost:5173/payment/result
# Chỉ để nhắc: URL này phải khai báo trong trang quản trị VNPay, code không đọc biến này
VNP_IPN_URL=https://<domain>.ngrok-free.app/api/payments/vnpay/ipn

# ===== ngrok (chỉ máy demo của trưởng nhóm cần điền) =====
NGROK_AUTHTOKEN=
NGROK_DOMAIN=