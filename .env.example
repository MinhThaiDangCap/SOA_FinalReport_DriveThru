# ===== PostgreSQL =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===== Tên database của từng service =====
AUTH_DB=auth_db
MENU_DB=menu_db
ORDER_DB=order_db
PAYMENT_DB=payment_db
FEEDBACK_DB=feedback_db

# ===== JWT (auth-service phát, các service khác kiểm tra) =====
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ===== Gọi nội bộ giữa các service =====
INTERNAL_KEY=change_me_internal_key
MENU_SERVICE_URL=http://menu-service:8000
ORDER_SERVICE_URL=http://order-service:8000
PAYMENT_SERVICE_URL=http://payment-service:8000

# ===== VNPay Sandbox (nhận qua email khi đăng ký sandbox) =====
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=https://<domain>.ngrok-free.app/payment/result
VNP_IPN_URL=https://<domain>.ngrok-free.app/api/payments/vnpay/ipn
# true = bỏ qua VNPay thật, dùng thanh toán giả để demo dự phòng
PAYMENT_MOCK_MODE=false

# ===== ngrok (chỉ máy demo của trưởng nhóm cần điền) =====
NGROK_AUTHTOKEN=
NGROK_DOMAIN=