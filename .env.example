# Cách dùng: sao chép file này thành .env rồi điền giá trị của bạn.
#   Windows PowerShell:  Copy-Item .env.example .env
# KHÔNG commit file .env (đã nằm trong .gitignore).
#
# Chạy bằng Docker Compose thì KHÔNG cần file .env: docker-compose.yml đã có giá trị
# mặc định cho mọi biến. Chỉ tạo .env khi muốn đổi giá trị (MoMo, ngrok, mật khẩu...).
# Mục "PostgreSQL" và "Địa chỉ service" bên dưới chỉ dùng khi chạy từng service
# bằng Python trên máy (không Docker); Docker Compose tự đặt các giá trị đó.

# ===== PostgreSQL =====
# Mặc định cổng 5432. Nếu cổng bị chiếm thì chạy container ở cổng khác và đổi số này.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ===== Mật khẩu tài khoản database của từng service (Docker Compose) =====
# Mỗi service đăng nhập PostgreSQL bằng tài khoản riêng (auth_user, menu_user...).
# Bỏ trống = dùng mặc định trong docker-compose.yml. Đổi mật khẩu chỉ có tác dụng khi
# database được tạo mới: docker compose down -v && docker compose up -d --build
AUTH_DB_PASSWORD=
MENU_DB_PASSWORD=
ORDER_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
FEEDBACK_DB_PASSWORD=

# ===== Tên database của từng service =====
AUTH_DB=auth_db
MENU_DB=menu_db
ORDER_DB=order_db
PAYMENT_DB=payment_db
FEEDBACK_DB=feedback_db

# ===== JWT (auth-service phát, các service khác kiểm tra) =====
# Cả nhóm phải dùng CÙNG giá trị. Trưởng nhóm gửi giá trị thật qua tin nhắn riêng.
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ===== Gọi nội bộ giữa các service =====
# Cả nhóm phải dùng CÙNG INTERNAL_KEY.
# Địa chỉ dưới đây dùng khi chạy local. Khi chạy bằng Docker Compose,
# từng container sẽ được ghi đè thành http://<tên-service>:8000.
INTERNAL_KEY=change_me_internal_key
AUTH_SERVICE_URL=http://127.0.0.1:8001
MENU_SERVICE_URL=http://127.0.0.1:8002
ORDER_SERVICE_URL=http://127.0.0.1:8003
PAYMENT_SERVICE_URL=http://127.0.0.1:8004

# ===== Chế độ giả lập khi dev (mặc định tắt) =====
# order-service: true = dùng món giả khi menu-service chưa chạy
MENU_MOCK=false
# payment-service: true = thanh toán giả, không gọi MoMo thật
PAYMENT_MOCK_MODE=false
# payment-service: true = trang kết quả cũng xử lý giao dịch.
# Bật khi chạy local không có ngrok, vì MoMo không gọi được IPN vào localhost.
MOMO_PROCESS_ON_RETURN=true
PUBLIC_BASE_URL=http://127.0.0.1:8004

# ===== MoMo Sandbox =====
# Để trống 3 dòng key = dùng bộ key test công khai của MoMo (không cần đăng ký).
# Nếu có tài khoản MoMo Business riêng thì điền vào, KHÔNG commit giá trị thật.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn
# Trang kết quả của web, MoMo chuyển khách về đây.
#   Chạy bằng Docker:           http://localhost:8080/payment/result
#   Chạy frontend bằng npm dev: http://localhost:5173/payment/result
#   Demo qua ngrok:             https://<domain>/payment/result
MOMO_REDIRECT_URL=http://localhost:8080/payment/result
# MoMo gọi vào đây để báo kết quả (cần địa chỉ public). Để trống = PUBLIC_BASE_URL + /api/payments/momo/ipn
# Ví dụ: https://<domain>.ngrok-free.app/api/payments/momo/ipn
MOMO_IPN_URL=

# ===== ngrok (cho truy cập từ Internet và nhận IPN của MoMo) =====
# Xem README mục 5. Token là bí mật: chỉ điền trong .env, KHÔNG điền vào file này.
# Domain viết không có https:// và không có / ở cuối, ví dụ: abc-xyz.ngrok-free.app
# Khi dùng ngrok nên đặt MOMO_PROCESS_ON_RETURN=false để chứng minh IPN chạy thật.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
