# ===== PostgreSQL (chạy local: container drivethru-pg ở cổng 5440) =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5440

# ===== Tên database của từng service =====
AUTH_DB=auth_db
MENU_DB=menu_db
ORDER_DB=order_db
PAYMENT_DB=payment_db
FEEDBACK_DB=feedback_db

# ===== JWT (auth-service phát, các service khác kiểm tra) =====
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ===== Gọi nội bộ giữa các service (chạy local bằng 127.0.0.1) =====
INTERNAL_KEY=change_me_internal_key
MENU_SERVICE_URL=http://127.0.0.1:8002
ORDER_SERVICE_URL=http://127.0.0.1:8003
PAYMENT_SERVICE_URL=http://127.0.0.1:8004

# ===== menu-service giả (true khi menu-service của B chưa chạy) =====
MENU_MOCK=true

# ===== VNPay Sandbox (nhận qua email khi đăng ký sandbox) =====
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5173/payment/result
# Chỉ để nhắc: URL này phải được khai báo trong trang quản trị VNPay, code không đọc biến này
VNP_IPN_URL=https://<domain>.ngrok-free.app/api/payments/vnpay/ipn

# ===== Chế độ dev cho payment-service =====
# true = thanh toán giả, không gọi VNPay thật
PAYMENT_MOCK_MODE=true
# true = trang return cũng xử lý kết quả (dùng khi VNPay chưa gọi được IPN vào máy local)
VNP_PROCESS_ON_RETURN=true
PUBLIC_BASE_URL=http://127.0.0.1:8004

# ===== ngrok (chỉ máy demo của trưởng nhóm cần điền) =====
NGROK_AUTHTOKEN=
NGROK_DOMAIN=